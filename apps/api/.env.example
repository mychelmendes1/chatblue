# Exemplo de variáveis da API (apps/api). Copie para .env e preencha.
# Aqui estão documentadas as variáveis do canal Instagram / Meta;
# as demais (DATABASE_URL, REDIS_URL, JWT_SECRET...) seguem o .env.example da raiz.

# URLs públicas
# Base pública desta API (callback OAuth e webhook) e do frontend (destino do redirect pós-OAuth)
API_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br

# Cifragem de segredos (tokens) com AES-256-GCM: 32 bytes em hex (64 caracteres) ou base64.
# Gere com: openssl rand -hex 32
# Sem esta variável os tokens ficam em texto puro (compatibilidade com instalações antigas).
ENCRYPTION_KEY=

# App da Meta (produto Instagram > "API setup with Instagram business login")
META_APP_ID=
# O App Secret também valida o X-Hub-Signature-256 dos webhooks
META_APP_SECRET=

# Instagram API with Instagram Login
# Padrão: ${API_URL}/api/integrations/instagram/callback (cadastrar igual no painel da Meta)
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=v21.0
# Token de verificação do webhook único: ${API_URL}/webhooks/instagram
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# true somente após aprovação do recurso Human Agent no App Review (janela de 7 dias para atendente humano)
INSTAGRAM_HUMAN_AGENT_ENABLED=false
# true para conexões manuais antigas (token de Página via Facebook Login) continuarem em graph.facebook.com
INSTAGRAM_LEGACY_FACEBOOK_GRAPH=false
