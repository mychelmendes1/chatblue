# URL base da API (Express). Deve ser a porta da API (3001), NÃO a do Next (3004).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Opcional: destino do proxy /api/* no next.config (sobrescreve o fallback acima).
# API_PROXY_TARGET=http://localhost:3001

# Wiki /docs no localhost: subir o Docusaurus em paralelo (porta 3002) e o Next faz proxy.
# Terminal 1: cd apps/web && npm run dev
# Terminal 2: cd docs-site && npm run start
# DOCS_DEV_URL=http://localhost:3002
# SKIP_DOCS_PROXY=1

# Link do ícone "biblioteca" no header (produção costuma ser /docs/)
# NEXT_PUBLIC_DOCS_URL=/docs/
